<?xml version="1.0" encoding="utf-8"?>
<!-- The Hima mark: shield + two overlapping mountains + two layered pine
     trees + a stream + a bird in flight — a fuller, more faithful redraw of
     design/logo/hima-logo.png. Rendered monochrome; recolored at call sites
     via Icon(tint=). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">
    <!-- shield outline -->
    <path
        android:pathData="M24,4.5 L40,10 v12.6 C40,32.4 33.2,40.2 24,43.5 C14.8,40.2 8,32.4 8,22.6 V10 Z"
        android:strokeColor="#2E4A38"
        android:strokeWidth="2"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- back mountain (smaller, left), with two small texture ticks -->
    <path
        android:pathData="M11,34 L17,20.5 L23,34"
        android:strokeColor="#2E4A38"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M14.5,28.5 L16,27 M15.7,31 L17.2,29.5"
        android:strokeColor="#2E4A38"
        android:strokeWidth="1"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- front mountain (taller, overlapping) -->
    <path
        android:pathData="M18.5,34 L26,15 L33.5,34"
        android:strokeColor="#2E4A38"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- stream at the base -->
    <path
        android:pathData="M11.5,36.5 C15,34.8 17.5,37.2 21,35.6 C24.5,34 27.5,36.5 31,35.2"
        android:strokeColor="#2E4A38"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- bird in flight, upper right -->
    <path
        android:pathData="M27.5,17 C29.3,14.8 30.7,14.8 32,16.3 C33.3,14.8 34.7,14.8 36.5,17"
        android:strokeColor="#2E4A38"
        android:strokeWidth="1.3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- tree 1 (smaller) -->
    <path android:pathData="M19,22.2 L16.4,27.2 L21.6,27.2 Z" android:fillColor="#2E4A38" />
    <path android:pathData="M19,26 L15.7,32.2 L22.3,32.2 Z" android:fillColor="#2E4A38" />
    <path android:pathData="M18.3,32.2 h1.4 v2.8 h-1.4 Z" android:fillColor="#2E4A38" />

    <!-- tree 2 (larger) -->
    <path android:pathData="M29,19.4 L26,25.2 L32,25.2 Z" android:fillColor="#2E4A38" />
    <path android:pathData="M29,23.8 L25.2,31 L32.8,31 Z" android:fillColor="#2E4A38" />
    <path android:pathData="M28.2,31 h1.6 v3.2 h-1.6 Z" android:fillColor="#2E4A38" />
</vector>
