<?xml version="1.0" encoding="utf-8"?>
<!-- Host/launch theme only — the real UI is themed in Compose (HimaTheme).
     Parent must be an AppCompat theme because MainActivity extends
     AppCompatActivity (required for the per-app language switch). -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.HimaAI" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/hima_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/hima_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>
</resources>
