<?xml version="1.0" encoding="utf-8"?>
<!-- PlayerView forced to TextureView (not the default SurfaceView), because a
     SurfaceView is composited by the system outside the normal view hierarchy
     and breaks when a RenderEffect-based Modifier.blur() is applied to it. -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/videoPlayerView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    app:surface_type="texture_view"
    app:resize_mode="zoom"
    app:use_controller="false"
    app:shutter_background_color="@android:color/transparent" />
